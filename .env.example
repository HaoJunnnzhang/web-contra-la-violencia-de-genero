# Copia este archivo como .env y rellena las contraseñas. El .env NUNCA se sube al repositorio.
# Formato KEY=valor, sin comillas ni espacios (lo leen systemd y los scripts de deploy/).
ADMIN_USER=admin
ADMIN_PASS=
PANTALLA_USER=pantalla
PANTALLA_PASS=
# Ruta del fichero SQLite (opcional; vacío = datos/25n.db dentro del proyecto)
DB_PATH=
